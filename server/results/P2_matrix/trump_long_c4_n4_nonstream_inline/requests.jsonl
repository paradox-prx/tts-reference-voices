{"run": "trump_long_c4_n4_nonstream_inline", "tag": "", "voice": "trump", "lang": "en", "size": "long", "c": 4, "idx": 2, "text_idx": 10, "take": 0, "seed": null, "prompt_id": null, "voice_mode": "inline", "engine_voice": null, "ref_nonce": null, "words": 58, "letters": 244, "chars": 318, "max_new_tokens": 549, "t_start": 1790292449.447, "latency": 4.26, "ttfb": null, "ttfa": null, "status": 200, "error": null, "bytes": 783404, "out_tokens": "205", "resp_headers": {"x-vllm-omni-input-tokens": "367", "x-vllm-omni-output-tokens": "205", "x-vllm-omni-total-tokens": "572", "x-vllm-omni-input-text-tokens": "76", "x-vllm-omni-input-audio-tokens": "291"}, "request": {"task_type": "Base", "response_format": "wav", "language": "English", "extra_params": {"temperature": 0.9, "top_k": 50}, "max_new_tokens": 549}, "params": {}, "text": "You know, I had the number one show on television. Number one. The ratings were through the roof, higher than anybody. And every year they had the big awards, and every year, who won? Not me. Some show nobody ever watched. Nobody! I'd sit there in the front row, smiling, clapping, and they'd give it to somebody else.", "audio_s": 16.32, "rtf": 0.261, "s_per_word": 0.281, "s_per_letter": 0.0669, "pace": 0.0795, "pace_source": "file", "pace_ratio": 0.841, "suspect_reason": null, "pcm_sha256": "5412a3595334ebb54223f22addac338d2b698a776affb7fe58887581705aa61c", "suspect": false, "file": "audio/002.wav"}
