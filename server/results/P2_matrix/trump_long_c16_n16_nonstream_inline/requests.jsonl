{"run": "trump_long_c16_n16_nonstream_inline", "tag": "", "voice": "trump", "lang": "en", "size": "long", "c": 16, "idx": 13, "text_idx": 33, "take": 0, "seed": null, "prompt_id": null, "voice_mode": "inline", "engine_voice": null, "ref_nonce": null, "words": 63, "letters": 239, "chars": 315, "max_new_tokens": 539, "t_start": 1790292460.174, "latency": 9.248, "ttfb": null, "ttfa": null, "status": 200, "error": null, "bytes": 814124, "out_tokens": "213", "resp_headers": {"x-vllm-omni-input-tokens": "370", "x-vllm-omni-output-tokens": "213", "x-vllm-omni-total-tokens": "583", "x-vllm-omni-input-text-tokens": "79", "x-vllm-omni-input-audio-tokens": "291"}, "request": {"task_type": "Base", "response_format": "wav", "language": "English", "extra_params": {"temperature": 0.9, "top_k": 50}, "max_new_tokens": 539}, "params": {}, "text": "It stayed right there. I walked over, and I just looked at it, and I said, thank you. Thank you, little ball. I was so relieved, I think I let out the biggest breath of my whole life. The caddie was laughing, I was laughing, everybody was so relieved. I've never been so happy to see a little white ball in my life.", "audio_s": 16.96, "rtf": 0.545, "s_per_word": 0.269, "s_per_letter": 0.071, "pace": 0.0795, "pace_source": "file", "pace_ratio": 0.893, "suspect_reason": null, "pcm_sha256": "6b8802a0373acfb68f2bc69e5e3df681783eb67c39d81ebafac709fd2913cbb8", "suspect": false, "file": "audio/013.wav"}
