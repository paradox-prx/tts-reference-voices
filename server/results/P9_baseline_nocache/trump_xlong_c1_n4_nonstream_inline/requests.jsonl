415d59159a02be1", "suspect": false, "file": "audio/000.flac"}
{"run": "trump_xlong_c1_n4_nonstream_inline", "tag": "", "voice": "trump", "lang": "en", "size": "xlong", "c": 1, "idx": 1, "text_idx": 1, "take": 0, "seed": null, "prompt_id": null, "voice_mode": "inline", "engine_voice": null, "ref_nonce": null, "words": 115, "letters": 448, "chars": 601, "max_new_tokens": 872, "t_start": 1790298246.296, "latency": 19.104, "ttfb": null, "ttfa": null, "status": 200, "error": null, "bytes": 1547652, "out_tokens": null, "resp_headers": {"x-request-id": "7e262af2a56344fab55a310e1227c270", "x-ai-generated": "true", "x-baseline-batch-size": "1", "x-baseline-batch-id": "31", "x-baseline-queue-ms": "20.3", "x-baseline-prompt-ms": "27.2", "x-baseline-gen-ms": "19046.5", "x-baseline-codec-frames": "403", "x-baseline-text-tokens": "155", "x-baseline-max-new-tokens": "872", "x-baseline-batch-max-new-tokens": "872", "x-baseline-finish-reason": "stop", "x-baseline-prompt-cache": "off", "x-baseline-retries": "0", "x-baseline-sample-rate": "24000"}, "request": {"task_type": "Base", "response_format": "wav", "language": "English", "extra_params": {"temperature": 0.9, "top_k": 50}, "max_new_tokens": 872}, "params": {}, "text": "So a reporter comes up to me, very nice guy, not so smart, and he says, sir, what's your golf handicap? And I said, what handicap? I don't have a handicap. I've won eighteen club championships. Eighteen! And he looks at me, and he says, sir, how many of those were at your own clubs? I said, that's a very unfair question. Very unfair. But a good question, I have to say. I liked him. I liked him a lot. He's going places, that guy. Not very far, but he's going places. Actually, I hired him later. True story. He writes down my golf scores now. Very accurate scores. The best scores you've ever seen.", "audio_s": 32.24, "rtf": 0.593, "s_per_word": 0.28, "s_per_letter": 0.072, "pace": 0.07, "pace_source": "file", "pace_ratio": 1.028, "suspect_reason": null, "pcm_sha256": "ed019d78f2b1354899276dd87f5330ba0f7be5977566e9853551f6e6e398c3ec", "suspect": false, "file": "audio/001.flac"}
