# Template: deploy/install_units.sh renders @SERVER@ (this checkout's server/ directory), @ENV_FILE@ and @PYTHON3@.
[Unit]
Description=Qwen3-TTS engine (vLLM-Omni, 127.0.0.1:8091)
Documentation=file://@SERVER@/docs/DESIGN.md
# At most 3 failed starts in 30 min: a crash loop must not keep reloading the model onto the GPU.
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
# FlashInfer's JIT sampler cannot compile with the pip nvcc 13.4 against the CUDA 13.0 headers (engine/run_engine.sh):
# use vLLM's PyTorch sampler. Values from EnvironmentFile= override Environment= (systemd.exec).
Environment=PYTHONUNBUFFERED=1 VLLM_USE_FLASHINFER_SAMPLER=0
EnvironmentFile=@ENV_FILE@
WorkingDirectory=@SERVER@
# Deploy YAML, port, venv and GPU come from TTS_ENGINE_DEPLOY / TTS_ENGINE_PORT / TTS_ENGINE_VENV / TTS_ENGINE_GPU
# in the env file (defaults: engine/deploy/qwen3_tts_prod.yaml, 8091, venvs/engine, GPU 0).
ExecStart=@SERVER@/engine/run_engine.sh
# The unit turns active (and the gateway, ordered after it, starts) only once a real synthesis returns audio.
ExecStartPost=@PYTHON3@ @SERVER@/engine/wait_ready.py --timeout 1700
# Model load + torch.compile + CUDA graph capture take minutes on a cold cache.
TimeoutStartSec=1800
Restart=on-failure
RestartSec=15
# SIGTERM to the API server only; it shuts its stage processes down, anything left is killed after the timeout.
KillMode=mixed
TimeoutStopSec=90
LimitNOFILE=65536
NoNewPrivileges=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qwen3-tts-engine

[Install]
WantedBy=default.target
