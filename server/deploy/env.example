# qwen3-tts-server environment. deploy/install_units.sh copies this to ~/.config/qwen3-tts/env (mode 600) with
# fresh random keys; the systemd user units read it (EnvironmentFile=). systemd syntax: KEY=value lines, no
# `export`, no command substitution, no ${VAR} expansion. Commented lines show the built-in default. Relative paths
# are relative to this checkout's server/ directory (the engine unit's working directory).
# Never commit a filled-in copy.

# ---------------------------------------------------------------- gateway (gateway/tts_gateway/config.py)
# Bearer key(s) clients must send; several may be comma-separated (rotation). install_units.sh generates one.
TTS_API_KEY=change-me
# 1 turns authentication off (tests only).
#TTS_AUTH_DISABLED=0
# vllm_omni (the engine below) or stub (deterministic fake engine, no GPU).
#TTS_BACKEND=vllm_omni
# Model name listed by GET /v1/models (the engine's served model).
#TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Engine base URL; keep the port equal to TTS_ENGINE_PORT below.
TTS_ENGINE_URL=http://127.0.0.1:8091
# Key between gateway and engine: the engine requires it on /v1 (run_engine.sh passes it as VLLM_API_KEY), the
# gateway sends it. install_units.sh generates one.
TTS_ENGINE_API_KEY=change-me-too
# 1 = the engine carries engine/patches rep_penalty (engine/install_engine.sh applies it; check with
# `engine/patches/apply_patches.py --venv venvs/engine --check`): per-request repetition_penalty is then honoured.
TTS_ENGINE_PER_REQUEST_RP=1
# voice-server/v1 folders (<id>/voice.json, references/references.json). Default: voices/ of this checkout.
#TTS_VOICES_DIR=
# registered: upload each voice to the engine once and send its name; inline: send ref_audio with every request;
# precomputed: the engine preloaded the voices (TTS_ENGINE_DEPLOY=engine/deploy/variants/custom_voices.yaml, written
# by engine/precompute_voices.py) and the gateway sends TTS_PRECOMPUTED_VOICE_NAME ({id}-avg: averaged speaker
# embedding + ICL; {id}-prompt: the reference clip's own embedding + ICL).
#TTS_VOICE_MODE=registered
#TTS_PRECOMPUTED_VOICE_NAME={id}-avg
# Requests in flight at the engine (keep <= the deploy YAML's max_num_seqs, 64); waiting requests beyond that
# (more -> 429); max wait for a slot (-> 503).
#TTS_MAX_INFLIGHT=32
#TTS_MAX_QUEUE=128
#TTS_QUEUE_TIMEOUT_S=60
# Timeout of one engine call, seconds.
#TTS_REQUEST_TIMEOUT_S=300
# Longer input -> 413.
#TTS_MAX_INPUT_CHARS=3000
# Extra takes for a suspect take, an engine failure or a failed QC check (non-streaming only), and which count.
#TTS_RETRY_MAX=1
# production (REPORT.md §8): pace/engine errors only; add ,qc together with TTS_QC_URL and TTS_RETRY_MAX=2
TTS_RETRY_ON=suspect,engine_error
# Split texts longer than this many words at sentence ends into parts (0 = never); the parts of a non-streaming
# request run in parallel on free engine slots and are joined with a 0.2 s pause (long Urdu: docs/EXPERIMENTS.md).
# production (REPORT.md §8): long Urdu 93% -> 12% severe failures together with non_streaming_mode
TTS_SPLIT_WORDS=60
# 1 = send max_new_tokens scaled to the text, bounding runaways; headroom over the suspect band's upper edge.
#TTS_LENGTH_CAP=1
#TTS_LENGTH_CAP_HEADROOM=1.2
# A take is suspect when its seconds per letter fall outside this multiple of the voice's expected pace; expected
# paces come from the calibration file, then TTS_PACE="voice=0.088,..." overrides.
#TTS_SUSPECT_BAND=0.6,1.8
# (default pace file: calibration/pace.json of this checkout)
#TTS_PACE_FILE=
#TTS_PACE=
# Fallback seconds-per-word bands, for text whose language differs from the reference's.
#TTS_SPW_EN=0.18,0.9
#TTS_SPW_UR=0.18,1.1
# Text languages (en, ur) for which non_streaming_mode=true is sent unless the request sets it: the whole text goes
# into the prefill instead of being fed one token per codec frame (docs/EXPERIMENTS.md, X6: long Urdu texts).
# production (REPORT.md §8): halves severe Urdu failures (15.5% -> 7.7% per take), -5% throughput
TTS_NON_STREAMING_MODE_LANGS=ur
# Talker sampling sent as extra_params unless the request sets it ("none" = leave it to the engine default).
#TTS_DEFAULT_TEMPERATURE=0.9
#TTS_DEFAULT_TOP_K=50
# Quality-check sidecar (server/qc, unit qwen3-tts-qc.service, optional): unset = off. The gateway fails open.
#TTS_QC_URL=http://127.0.0.1:8092
#TTS_QC_CHECKS=asr,sim,audio
#TTS_QC_TIMEOUT_S=30
# 1 = one short request per voice before /ready turns green.
#TTS_WARMUP=1
# 1 = accept ref_audio/ref_text (inline cloning) in requests.
#TTS_ALLOW_INLINE_REF=0
# JSON logs to stdout (journald); timestamps in this zone.
#TTS_LOG_LEVEL=INFO
#TTS_LOG_TZ=Asia/Karachi
# Gateway bind address and port.
#TTS_HOST=0.0.0.0
#TTS_PORT=8090
# Seconds to finish in-flight requests on shutdown (the unit's TimeoutStopSec is 45).
#TTS_SHUTDOWN_GRACE_S=30

# Stub backend only (TTS_BACKEND=stub; tests and gateway-overhead runs).
#TTS_STUB_SPW=0.35
#TTS_STUB_BASE_LATENCY_S=0
#TTS_STUB_LATENCY_PER_AUDIO_S=0
#TTS_STUB_SUSPECT_TAKES=0
#TTS_STUB_FAIL_TAKES=0
#TTS_STUB_FAIL_KIND=retryable
#TTS_STUB_MAX_SECONDS_PER_CALL=none
#TTS_STUB_REPETITION_PENALTY=0

# ---------------------------------------------------------------- engine (engine/run_engine.sh)
# Deploy YAML, port (127.0.0.1 only) and venv of the vLLM-Omni engine. For the precomputed voices use
# engine/deploy/variants/custom_voices.yaml (run engine/precompute_voices.py first).
# production (REPORT.md §8): the prod YAML + the precomputed voices (engine/precompute_voices.py)
TTS_ENGINE_DEPLOY=engine/deploy/variants/custom_voices.yaml
TTS_ENGINE_PORT=8091
#TTS_ENGINE_VENV=venvs/engine
# Physical GPU (PCI order, as nvidia-smi numbers them). Do not set CUDA_VISIBLE_DEVICES here: every unit reads this
# file, and a CUDA_VISIBLE_DEVICES would also move the QC sidecar (it wins over TTS_ENGINE_GPU in run_engine.sh).
TTS_ENGINE_GPU=0
# vLLM's PyTorch top-k/top-p sampler: FlashInfer's JIT sampler does not compile with this venv's pip nvcc 13.4
# against the CUDA 13.0 runtime headers (see engine/run_engine.sh). 1 only after pinning nvcc to 13.0.88.
VLLM_USE_FLASHINFER_SAMPLER=0
# HF repo id (resolved to the local HF cache snapshot while HF_HUB_OFFLINE=1) or a local model directory.
#TTS_ENGINE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Served model name (default: the repo id, or the directory name for a local path).
#TTS_ENGINE_SERVED_NAME=
#TTS_ENGINE_HOST=127.0.0.1
# Directory that file:// ref_audio may read (vllm --allowed-local-media-path); empty = file:// refused.
#TTS_ENGINE_ALLOWED_MEDIA_PATH=
# Per-stage and total start-up timeouts, seconds (first start compiles and captures CUDA graphs).
#TTS_ENGINE_STAGE_INIT_TIMEOUT=900
#TTS_ENGINE_INIT_TIMEOUT=1200
# Extra `vllm serve` arguments, space-separated (e.g. --no-async-chunk).
#TTS_ENGINE_EXTRA_ARGS=
# Where voices uploaded through POST /v1/audio/voices persist.
#SPEAKER_SAMPLES_DIR=state/speakers
# 1 = never contact the Hugging Face Hub.
#HF_HUB_OFFLINE=1

# ---------------------------------------------------------------- engine watchdog (deploy/health_watchdog.py)
# Seconds between /health checks, and consecutive failures (non-200, error, timeout) before an engine restart.
#TTS_WATCHDOG_INTERVAL_S=15
#TTS_WATCHDOG_FAILURES=4
