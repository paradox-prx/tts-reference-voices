# higgs-studio settings. Copy to .env (setup.sh does) and edit. No secrets are needed: both consoles are for the
# internal network / VPN only and have no login. Relative paths are relative to this folder.

# ---- engine (engine/run_engine.sh, setup.sh) ----------------------------------------------------------------------
# An existing vLLM 0.28.0 + vLLM-Omni 0.28.0 venv to reuse instead of building engine/.venv (~4 GB):
# HIGGS_ENGINE_VENV=/path/to/venvs/engine
HIGGS_ENGINE_PORT=8095
HIGGS_ENGINE_GPU=0
# engine/deploy/higgs_3090_32.yaml: 32 concurrent requests, stage 0 at 0.72 of a 24 GB card (best throughput)
# engine/deploy/higgs_3090_16.yaml: upstream memory split (0.60 / 0.25), 16 concurrent requests
HIGGS_ENGINE_DEPLOY=engine/deploy/higgs_3090_32.yaml
# HF repo id (taken from the HF cache, $HF_HOME/hub) or a local checkpoint directory:
HIGGS_MODEL=bosonai/higgs-tts-3-4b
# HIGGS_AUDIO_TOKENIZER_PATH=/path/to/OmniVoice/audio_tokenizer     (default: k2-fsa/OmniVoice in the HF cache)
# HF_HOME=/data/huggingface
# Optional key on the engine's /v1 API (the studio sends it automatically):
# HIGGS_ENGINE_API_KEY=

# ---- studio (app/studio/settings.py) -------------------------------------------------------------------------------
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8100
# STUDIO_ENGINE_URL=http://127.0.0.1:8095        (default: localhost at HIGGS_ENGINE_PORT)
STUDIO_VOICES_DIR=voices
STUDIO_DATA_DIR=data
# requests in flight at the engine (keep below the deploy's max_num_seqs: 32 / 16) and the share dev jobs may use;
# customers always keep the remaining slots and jump the queue
STUDIO_MAX_INFLIGHT=28
STUDIO_DEV_MAX_INFLIGHT=24
STUDIO_CUSTOMER_QUEUE_MAX=40
STUDIO_MAX_PART_S=25
STUDIO_JOIN_GAP_S=0.3
STUDIO_TAKE_TTL_H=24
STUDIO_MAX_UPLOAD_MB=50
