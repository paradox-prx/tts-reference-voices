# qwen3-tts-server environment. deploy/install_units.sh copies this to ~/.config/qwen3-tts/env (mode 600) with
# fresh random keys; both systemd user units read it (EnvironmentFile=). systemd syntax: KEY=value lines, no
# `export`, no command substitution, no ${VAR} expansion. Commented lines show the built-in default.
# Never commit a filled-in copy.

# ---------------------------------------------------------------- gateway (gateway/tts_gateway/config.py)
# Bearer key(s) clients must send; several may be comma-separated (rotation). install_units.sh generates one.
TTS_API_KEY=change-me
# 1 turns authentication off (tests only).
#TTS_AUTH_DISABLED=0
# vllm_omni (the engine below) or stub (deterministic fake engine, no GPU).
#TTS_BACKEND=vllm_omni
# Model name listed by GET /v1/models (the engine's served model).
#TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Engine base URL; keep the port equal to TTS_ENGINE_PORT below.
TTS_ENGINE_URL=http://127.0.0.1:8091
# Key between gateway and engine: the engine requires it on /v1 (run_engine.sh passes it as VLLM_API_KEY), the
# gateway sends it. install_units.sh generates one.
TTS_ENGINE_API_KEY=change-me-too
# 1 = the engine carries engine/patches rep_penalty (every venv built by engine/install_engine.sh does; check with
# `engine/patches/apply_patches.py --venv VENV --check`): per-request repetition_penalty is then honoured.
TTS_ENGINE_PER_REQUEST_RP=1
# voice-server/v1 folders (<id>/voice.json, references/references.json).
#TTS_VOICES_DIR=/home/vector/tts-reference-voices/voices
# registered: upload each voice to the engine once and send `voice`; inline: send ref_audio with every request.
#TTS_VOICE_MODE=registered
# Requests in flight at the engine; waiting requests beyond that (more -> 429); max wait for a slot (-> 503).
#TTS_MAX_INFLIGHT=32
#TTS_MAX_QUEUE=128
#TTS_QUEUE_TIMEOUT_S=60
# Timeout of one engine call, seconds.
#TTS_REQUEST_TIMEOUT_S=300
# Longer input -> 413.
#TTS_MAX_INPUT_CHARS=3000
# Extra takes for a suspect take or an engine failure (non-streaming only), and which failures count.
#TTS_RETRY_MAX=1
#TTS_RETRY_ON=suspect,engine_error
# 1 = send max_new_tokens scaled to the word count, bounding runaways.
#TTS_LENGTH_CAP=1
# Seconds-per-word band per language; a take outside it is suspect.
#TTS_SPW_EN=0.18,0.9
#TTS_SPW_UR=0.18,1.1
# Talker sampling sent as extra_params unless the request sets it ("none" = leave it to the engine default).
#TTS_DEFAULT_TEMPERATURE=0.9
#TTS_DEFAULT_TOP_K=50
# 1 = one short request per voice before /ready turns green.
#TTS_WARMUP=1
# 1 = accept ref_audio/ref_text (inline cloning) in requests.
#TTS_ALLOW_INLINE_REF=0
# JSON logs to stdout (journald).
#TTS_LOG_LEVEL=INFO
# Gateway bind address and port.
#TTS_HOST=0.0.0.0
#TTS_PORT=8090
# Seconds to finish in-flight requests on shutdown (the unit's TimeoutStopSec is 45).
#TTS_SHUTDOWN_GRACE_S=30

# Stub backend only (TTS_BACKEND=stub; tests and gateway-overhead runs).
#TTS_STUB_SPW=0.35
#TTS_STUB_BASE_LATENCY_S=0
#TTS_STUB_LATENCY_PER_AUDIO_S=0
#TTS_STUB_SUSPECT_TAKES=0
#TTS_STUB_FAIL_TAKES=0
#TTS_STUB_FAIL_KIND=retryable
#TTS_STUB_MAX_SECONDS_PER_CALL=none
#TTS_STUB_REPETITION_PENALTY=0

# ---------------------------------------------------------------- engine (engine/run_engine.sh)
# Deploy YAML, port (127.0.0.1 only) and venv of the vLLM-Omni engine.
TTS_ENGINE_DEPLOY=/home/vector/qwen3-tts-server/engine/deploy/qwen3_tts_prod.yaml
TTS_ENGINE_PORT=8091
TTS_ENGINE_VENV=/home/vector/qwen3-tts-server/venvs/engine
# Physical GPU (PCI order, as nvidia-smi numbers them). The gateway ignores it.
CUDA_VISIBLE_DEVICES=1
# HF repo id (resolved to the local HF cache snapshot while HF_HUB_OFFLINE=1) or a local model directory.
#TTS_ENGINE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Served model name (default: the repo id, or the directory name for a local path).
#TTS_ENGINE_SERVED_NAME=
#TTS_ENGINE_HOST=127.0.0.1
# Directory that file:// ref_audio may read (vllm --allowed-local-media-path); empty = file:// refused.
#TTS_ENGINE_ALLOWED_MEDIA_PATH=
# Per-stage and total start-up timeouts, seconds (first start compiles and captures CUDA graphs).
#TTS_ENGINE_STAGE_INIT_TIMEOUT=900
#TTS_ENGINE_INIT_TIMEOUT=1200
# Extra `vllm serve` arguments, space-separated (e.g. --no-async-chunk).
#TTS_ENGINE_EXTRA_ARGS=
# Where voices uploaded through POST /v1/audio/voices persist.
#SPEAKER_SAMPLES_DIR=/home/vector/qwen3-tts-server/state/speakers
# 1 = never contact the Hugging Face Hub.
#HF_HUB_OFFLINE=1
# Fallback if FlashInfer's JIT sampler fails on this box: 0 = vLLM's PyTorch top-k/top-p sampler.
#VLLM_USE_FLASHINFER_SAMPLER=1
