# Template: deploy/install_units.sh renders @SERVER@ (this checkout's server/ directory), @ENV_FILE@ and @PYTHON3@.
[Unit]
Description=Qwen3-TTS gateway (OpenAI-compatible /v1/audio/speech on :8090)
Documentation=file://@SERVER@/docs/DESIGN.md
# Wants= pulls the engine in; After= waits for its start job, which ends once wait_ready.py got audio back. The
# gateway also survives engine restarts on its own: /ready turns red and requests get 503 until the engine is back.
Wants=qwen3-tts-engine.service
# The QC sidecar is optional (TTS_QC_URL; the gateway fails open when it is down): ordering only, no dependency, so
# the gateway starts whether qwen3-tts-qc.service is enabled, missing or failed.
After=qwen3-tts-engine.service qwen3-tts-qc.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@ENV_FILE@
WorkingDirectory=@SERVER@/gateway
ExecStart=@SERVER@/venvs/gateway/bin/python -m tts_gateway
TimeoutStartSec=120
Restart=on-failure
RestartSec=5
# Longer than TTS_SHUTDOWN_GRACE_S (30 s) so in-flight requests can finish.
KillMode=mixed
TimeoutStopSec=45
LimitNOFILE=65536
NoNewPrivileges=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qwen3-tts-gateway

[Install]
WantedBy=default.target
