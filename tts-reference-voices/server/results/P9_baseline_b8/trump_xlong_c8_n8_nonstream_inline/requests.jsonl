false, "file": "audio/006.flac"}
{"run": "trump_xlong_c8_n8_nonstream_inline", "tag": "", "voice": "trump", "lang": "en", "size": "xlong", "c": 8, "idx": 7, "text_idx": 19, "take": 0, "seed": null, "prompt_id": null, "voice_mode": "inline", "engine_voice": null, "ref_nonce": null, "words": 117, "letters": 435, "chars": 583, "max_new_tokens": 848, "t_start": 1790296971.405, "latency": 22.746, "ttfb": null, "ttfa": null, "status": 200, "error": null, "bytes": 1459332, "out_tokens": null, "resp_headers": {"x-request-id": "b5d52efde0ea4e2cbf3797cc6702191c", "x-ai-generated": "true", "x-baseline-batch-size": "8", "x-baseline-batch-id": "58", "x-baseline-queue-ms": "1.6", "x-baseline-prompt-ms": "1.7", "x-baseline-gen-ms": "22692.8", "x-baseline-codec-frames": "380", "x-baseline-text-tokens": "153", "x-baseline-max-new-tokens": "848", "x-baseline-batch-max-new-tokens": "942", "x-baseline-finish-reason": "stop", "x-baseline-prompt-cache": "hit", "x-baseline-retries": "0", "x-baseline-sample-rate": "24000"}, "request": {"task_type": "Base", "response_format": "wav", "language": "English", "extra_params": {"temperature": 0.9, "top_k": 50}, "max_new_tokens": 848}, "params": {}, "text": "I have to admit something, and it's not easy for me. I don't admit things very often. Last week, I was playing golf with my caddie, a young guy, very nice, and I told him, I'm going to beat you by ten strokes. Ten! And I lost. I lost to the caddie. By four strokes. And everybody at the club heard about it. Everybody. I walked into the dining room and it got very quiet. Very quiet. People were looking down at their soup. I'll be honest with you, I was embarrassed. But I'll get him next time. I gave him a very big tip, though. A very, very big tip. So he won't tell anybody else.", "audio_s": 30.4, "rtf": 0.748, "s_per_word": 0.26, "s_per_letter": 0.0699, "pace": 0.07, "pace_source": "file", "pace_ratio": 0.998, "suspect_reason": null, "pcm_sha256": "564611d2c4ce5a7391a2eeb7dcd850441a5df5bc8a012794945af79c0e01db87", "suspect": false, "file": "audio/007.flac"}
